[sub_resource type="GDScript" id="GDScript_108wt"]
script/source = "extends Node2D

@onready var b=$CharacterBody2D/Ghostanimation
@onready var s=$AudioStreamPlayer
@onready var health =$Ghealth_bar
@onready var hitbox: Area2D =$CharacterBody2D/Hitbox
@onready var hit_shape:CollisionShape2D = $CharacterBody2D/Hitbox/CollisionShape2D
var speed:=200
var dir:=1
var already_hit:=false

func _ready() -> void:
	health._init_health(6)
	hit_shape.disabled = true
	$CharacterBody2D/Hurtbox.add_to_group(\"hurtbox\")
	hitbox.area_entered.connect(_on_hitbox_area_entered)
func _process(del):
	if Input.is_action_pressed(\"Botleft\"):
		position.x-=speed*dir*del
		b.play(\"walk\")
		b.flip_h = true
		
	elif Input.is_action_pressed(\"botright\"):
		position.x+=speed*dir*del
		b.play(\"walk\")
		b.flip_h = false
	elif Input.is_action_pressed(\"Pucnhplayer2\"):
		already_hit=false
		hit_shape.disabled=false
		b.play(\"Punch\")
		s.play()
		await get_tree().create_timer(0.15).timeout
	else:
		b.play(\"Idle\")
		
func take_damage(amount:int)-> void:
	health.health -=amount
	if health.health<=0:
		queue_free()
	
func _on_hitbox_area_entered(area:Area2D) -> void:
	if already_hit:
		return
		
	if not area.is_in_group(\"hurtbox\"):
		return
		
	var opponent : Node=area
	
	while opponent !=null and not opponent.has_method(\"take_damage\"):
		opponent = opponent.get_parent()
		
	if opponent !=null:
		opponent.take_damage(1)
		already_hit = true
		print(\"hit\")	
"

